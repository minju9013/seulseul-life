PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vibe_db

# Cloudinary (이미지 업로드)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 허용할 클라이언트 도메인 (여러 개면 쉼표로 구분)
# 예: https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (인증 전용)
# Project URL — JWT Signing Keys(ES256) 검증에 필요 (필수)
SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy JWT Secret — HS256 토큰만 쓰는 구 프로젝트 호환용 (선택)
# JWT Signing Keys 로 이전한 프로젝트는 SUPABASE_URL 만 있으면 됩니다.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
