PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vibe_db

# Cloudinary (이미지 업로드)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 허용할 클라이언트 도메인 (여러 개면 쉼표로 구분)
# 예: https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (인증 전용)
# Supabase 대시보드 > Project Settings > API > JWT Settings > JWT Secret 값
# 이 시크릿으로 클라이언트가 보낸 액세스 토큰(HS256)을 검증한다.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
